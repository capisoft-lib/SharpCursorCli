<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Capisoft.Lib.SharpCursorCli</RootNamespace>
    <PackageId>Capisoft.Lib.SharpCursorCli.Storage</PackageId>
    <Description>Lightweight SQLite storage for Cursor Agent conversation IDs (session_id, request_id, prompt preview) for retrieval across restarts.</Description>
    <PackageTags>Cursor;CLI;Agent;Storage;SQLite</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Capisoft.Lib.SharpCursorCli.Abstractions\Capisoft.Lib.SharpCursorCli.Abstractions.csproj" />
  </ItemGroup>
</Project>
