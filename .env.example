# Copy to .env and set your Cursor Agent path.
# Do not commit .env (it is in .gitignore).
#
# Windows (PowerShell script):
# CURSOR_AGENT_PATH=C:\Users\...\AppData\Local\cursor-agent\agent.ps1
#
# Or use agent from PATH (leave unset or comment out to fall back to PATH):
# CURSOR_AGENT_PATH=
CURSOR_AGENT_PATH=C:\Users\...\AppData\Local\cursor-agent\agent.ps1
